# Local PostgreSQL database started by docker compose up -d
POSTGRES_PASSWORD=replace-with-your-local-database-password
DATABASE_URL=postgresql://ubec_app:replace-with-your-local-database-password@127.0.0.1:54329/ubec
AUTH_SECRET=replace-this-with-a-long-random-local-development-secret

# Optional Redis (cache of per-state school lists, DNEMIS sync job queue and lock). Leave unset locally:
# without it nothing is cached and "Sync now" runs inside the web process. Production sets redis://redis:6379.
# REDIS_URL=redis://127.0.0.1:6379

# Outgoing email (password reset links). Leave SMTP_HOST unset locally: emails are printed in the dev server log.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=beapms@example.com
# SMTP_PASSWORD=
# SMTP_FROM="BEAPMS <no-reply@ubec.gov.ng>"
# Portal address used in emailed links (production must set it; locally the request origin is used).
# APP_URL=http://localhost:5173
